<Window x:Class="AuroraFileManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Aurora File Manager" Height="720" Width="1120" MinHeight="520" MinWidth="800"
 WindowStartupLocation="CenterScreen" Background="#F6F6F9">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="White" Padding="14" BorderBrush="#E6E6EC" BorderThickness="0,0,0,1">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="Aurora" FontSize="23" FontWeight="SemiBold" Foreground="#6558D3" Margin="0,0,22,0"/>
     <Button Content="← Back" Click="Back_Click"/>
     <Button Content="↑ Up" Click="Up_Click"/>
     <Button Content="↻ Refresh" Click="Refresh_Click"/>
    </StackPanel>
    <TextBox x:Name="SearchBox" Width="260" Height="32" VerticalContentAlignment="Center" HorizontalAlignment="Right"
      ToolTip="Search this folder" TextChanged="SearchBox_TextChanged"/>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="10" Margin="0,0,10,0">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="QUICK ACCESS" FontSize="11" FontWeight="Bold" Foreground="#77778A" Margin="8,8,0,12"/>
     <ListBox x:Name="PlacesList" BorderThickness="0" SelectionChanged="PlacesList_SelectionChanged" FontSize="14">
      <ListBoxItem Content="Home" Tag="HOME"/>
      <ListBoxItem Content="Desktop" Tag="Desktop"/>
      <ListBoxItem Content="Documents" Tag="MyDocuments"/>
      <ListBoxItem Content="Downloads" Tag="Downloads"/>
      <ListBoxItem Content="Pictures" Tag="MyPictures"/>
      <ListBoxItem Content="Music" Tag="MyMusic"/>
      <ListBoxItem Content="Videos" Tag="MyVideos"/>
      <ListBoxItem Content="This PC" Tag="DRIVES"/>
     </ListBox>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="12">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="PathText" FontSize="13" Foreground="#55556A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <Button Content="New folder" Click="NewFolder_Click"/>
       <Button Content="New file" Click="NewFile_Click"/>
       <Button Content="Paste" Click="Paste_Click"/>
       <Button Content="⋯" Click="More_Click" Width="38"/>
      </StackPanel>
     </DockPanel>
     <ListView x:Name="FilesList" SelectionMode="Extended" MouseDoubleClick="FilesList_MouseDoubleClick"
       KeyDown="FilesList_KeyDown" BorderThickness="0"
       ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
       VirtualizingPanel.VirtualizationMode="Recycling">
      <ListView.View>
       <GridView>
        <GridViewColumn Header="Name" Width="390" DisplayMemberBinding="{Binding Name}"/>
        <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding Type}"/>
        <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Size}"/>
        <GridViewColumn Header="Date modified" Width="150" DisplayMemberBinding="{Binding Modified}"/>
       </GridView>
      </ListView.View>
     </ListView>
    </DockPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#F0EFF5" Padding="10,3">
   <TextBlock x:Name="StatusText" FontSize="11" Foreground="#666678"/>
  </Border>
 </Grid>
</Window>